# Clé API Stripe en LECTURE SEULE (clé restreinte « rk_live_… »).
# À créer dans Stripe > Développeurs > Clés API > Créer une clé restreinte (voir LISEZ-MOI.md).
STRIPE_API_KEY=rk_live_xxx

# Liens de paiement suivis (séparés par des virgules). Vide = tous les liens sauf ceux marqués « test ».
STRIPE_PAYMENT_LINKS=plink_1UUtZkGxbVO4xQWJ2aNK3XCq

# Durée pendant laquelle les données Stripe sont gardées en mémoire (secondes).
CACHE_SECONDES=60

# Adresse locale du dashboard : http://127.0.0.1:8037
PORT=8037
